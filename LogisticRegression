redundant = ["MultipleLines", "OnlineSecurity", "OnlineBackup", "DeviceProtection",
             "TechSupport", "StreamingTV", "StreamingMovies"]
for c in redundant:
    data[c] = data[c].replace({"No internet service": "No", "No phone service": "No"})

# 8. One-hot encode
